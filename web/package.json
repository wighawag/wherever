{
	"name": "@wherever-dev/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"dependencies": {
		"@wherever-dev/client": "workspace:*",
		"dompurify": "^3.4.11",
		"marked": "^15.0.12"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24.3.0",
		"fake-indexeddb": "^6.2.6",
		"ipfs-gateway-emulator": "4.2.1-ipfs.2",
		"named-logs": "^0.4.1",
		"prettier": "^3.7.3",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"pwag": "^0.6.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.0.0",
		"vite": "^7.2.4",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^2.1.8"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons-and-tags && svelte-kit sync",
		"generate-pwa-icons-and-tags": "pwag static/logo.svg src/web-config.json",
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"serve": "ipfs-emulator --only -d build -p 8080"
	}
}
