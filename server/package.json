  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "ai-agent",
    "remote-control",
    "web-ui",
    "mobile",
    "pwa",
    "multi-session",
    "mcp",
    "websocket",
    "self-hosted",
    "wherever"
  ],
  "homepage": "https://wherever.dev",
  "bugs": {
    "url": "https://github.com/wighawag/wherever/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/wherever.git",
    "directory": "server"
  },
  "license": "AGPL-3.0-only",
  "author": "wighawag <wighawag@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wherever": "./dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "memonaut": "^0.1.0",
    "semver": "^7.7.0",
    "typebox": "^1.1.38",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts start",
    "start": "node dist/index.js start",
    "test": "vitest run",
    "test:watch": "vitest"
  }
