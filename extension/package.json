{
  "name": "@wherever-dev/pi",
  "version": "0.4.9",
  "description": "Remote control extension for pi coding agent with HTTP/WebSocket API (wherever.dev)",
  "homepage": "https://github.com/wighawag/wherever#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/wherever.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/wighawag/wherever/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "remote",
    "websocket",
    "http"
  ],
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@wherever-dev/client": "workspace:*",
    "typebox": "^1.1.38",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "client": "tsx src/client.ts",
    "start": "node dist/index.js"
  }
}
