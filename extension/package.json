{
  "name": "@wherever-dev/pi",
  "version": "0.5.6",
  "description": "pi coding agent extension that bridges a terminal pi session to a Wherever server, to follow and steer it from your phone or any browser (wherever.dev)",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "remote-control",
    "bridge",
    "mobile",
    "websocket",
    "wherever"
  ],
  "homepage": "https://wherever.dev",
  "bugs": {
    "url": "https://github.com/wighawag/wherever/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/wherever.git",
    "directory": "extension"
  },
  "license": "AGPL-3.0-only",
  "author": "wighawag <wighawag@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@wherever-dev/client": "workspace:*",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typebox": "^1.1.38",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "client": "tsx src/client.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts"
  }
}
