{
  "name": "wherever-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "ldenv": "^0.3.16",
    "set-defaults": "^0.0.5",
    "syncpack": "^13.0.4",
    "zellij-launcher": "^0.0.1"
  },
  "scripts": {
    "prepare": "set-defaults .vscode",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm format:check && pnpm build:all",
    "release": "pnpm prepublishOnly && git push --all && pnpm changeset publish && git push --tags",
    "release:ci": "pnpm prepublishOnly && pnpm changeset publish",
    "---------------------- FORMATING ----------------------": "",
    "format": "pnpm run -r format",
    "format:check": "pnpm run -r format:check",
    "---------------------- DEV ----------------------": "",
    "ext:dev": "ldenv pnpm --filter ./extension dev",
    "web:dev": "ldenv pnpm --filter ./web dev",
    "web:build": "ldenv pnpm --filter ./web build",
    "site:build": "ldenv pnpm --filter ./site build",
    "server:dev": "ldenv pnpm --filter ./server dev",
    "server:build": "ldenv pnpm --filter ./server build",
    "---------------------- DEPLOY ----------------------": "",
    "build": "node scripts/build.js",
    "build:all": "pnpm --filter ./client build && pnpm build && pnpm --filter ./vscode build",
    "serve": "pnpm run --filter ./web serve",
    "---------------------- RUN FULL LOCAL SETUP ----------------------": "",
    "stop": "zellij kill-session $npm_package_name",
    "start:pnpm": "pnpm -r dev",
    "start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
  }
}
